{
    "name": "easy-editor",
    "version": "0.1.0",
    "private": true,
    "description": "基于 Tiptap 的可复用富文本编辑器，pnpm monorepo（core / vue3 & vue2 适配层 / demo）",
    "packageManager": "pnpm@10.32.1",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "pnpm --filter @shenjipo/demo-vue3 dev",
        "dev:vue2": "pnpm --filter @shenjipo/demo-vue2 dev",
        "build": "pnpm -r --filter \"./packages/**\" build",
        "build:libs": "pnpm -r --filter @shenjipo/editor-core --filter @shenjipo/editor-vue2 --filter @shenjipo/editor-vue3 build",
        "typecheck": "pnpm -r typecheck",
        "preview": "pnpm --filter @shenjipo/demo-vue3 preview",
        "preview:vue2": "pnpm --filter @shenjipo/demo-vue2 preview",
        "clean": "pnpm -r exec node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
        "changeset": "changeset",
        "version:packages": "changeset version && pnpm install --lockfile-only",
        "check:versions": "node scripts/check-versions.mjs",
        "release:dry": "pnpm check:versions && pnpm -r publish --access public --dry-run --no-git-checks",
        "release": "pnpm check:versions && pnpm -r publish --access public && changeset tag"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.3",
        "typescript": "^5.9.2",
        "vue-tsc": "^3.3.11"
    }
}