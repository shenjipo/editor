{
    "name": "easy-editor",
    "version": "0.1.0",
    "private": true,
    "description": "基于 Tiptap 的可复用富文本编辑器，pnpm monorepo（core / vue3 & vue2 适配层 / demo）",
    "packageManager": "pnpm@10.32.1",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "pnpm --filter @easy-editor/demo-vue3 dev",
        "dev:vue2": "pnpm --filter @easy-editor/demo-vue2 dev",
        "build": "pnpm -r --filter \"./packages/**\" build",
        "typecheck": "pnpm -r typecheck",
        "preview": "pnpm --filter @easy-editor/demo-vue3 preview",
        "preview:vue2": "pnpm --filter @easy-editor/demo-vue2 preview",
        "clean": "pnpm -r exec node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
        "pub": "pnpm publish -F @easy-editor/core",
        "pub2": "pnpm publish --recursive -F @easy-editor/vue2",
        "pub3": "pnpm publish --recursive -F @easy-editor/vue3"
    },
    "devDependencies": {
        "typescript": "^5.9.2",
        "vue-tsc": "^3.3.11"
    }
}