{
  "name": "@easy-editor/vue3",
  "version": "0.1.0",
  "description": "easy-editor 的 Vue 3 适配层：编辑器组件、工具栏 UI 与 v-model 双向绑定",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@easy-editor/core": "workspace:*"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "@tiptap/vue-3": "3.31.3",
    "@types/node": "^22.13.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "^5.9.2",
    "vite": "^8.3.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
